# DATABASE_URL=postgres://url # to connect to a prod db that only gives a URL

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASS=password

SPOTIFY_CLIENT_ID=00000000000000000000000000000000
SPOTIFY_CLIENT_SECRET=00000000000000000000000000000000

# Used when resetting the spotify cache
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888
# SPOTIFY_CACHE=whatever

MUSICBRAINZ_USERAGENT=jbrown1618/spotify-stats
MUSICBRAINZ_VERSION=1.0.0
MUSICBRAINZ_CONTACT=https://github.com/jbrown1618/spotify-stats
MUSICBRAINZ_MAX_TRACKS_PER_RUN=100
MUSICBRAINZ_MAX_ARTISTS_PER_RUN=50
MUSICBRAINZ_SAVE_BATCH_SIZE=100
MUSICBRAINZ_RETRY_DAYS=60

DISCOGS_USER_TOKEN=00000000000000000000000000000000000