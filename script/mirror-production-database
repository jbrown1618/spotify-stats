#!/usr/bin/env bash

set -Eeuo pipefail

if [[ $# -ne 1 || -z $1 ]]; then
    echo "Usage: $0 <production-database-url>" >&2
    exit 1
fi

production_database_url=$1
dev_database=${POSTGRES_DB:-spotifystats}
backup_database="${dev_database}_$(date -u +%Y%m%d_%H%M%S)"
local_host=${POSTGRES_HOST:-127.0.0.1}
local_port=${POSTGRES_PORT:-5432}
local_user=${POSTGRES_USER:-postgres}
export PGPASSWORD=${POSTGRES_PASS:-${PGPASSWORD:-password}}

local_connection=(
    --host "$local_host"
    --port "$local_port"
    --username "$local_user"
)

missing_commands=()
for command in pg_dump pg_restore psql; do
    if ! command -v "$command" >/dev/null 2>&1; then
        missing_commands+=("$command")
    fi
done

if (( ${#missing_commands[@]} > 0 )); then
    echo "Error: missing required PostgreSQL CLI command(s): ${missing_commands[*]}." >&2
    echo "Install the PostgreSQL client tools and ensure they are available on PATH." >&2
    exit 1
fi

database_exists() {
    psql "${local_connection[@]}" \
        --dbname postgres \
        --set database_name="$1" \
        --tuples-only \
        --no-align \
        --command "SELECT 1 FROM pg_database WHERE datname = :'database_name'" |
        grep -q '^1$'
}

if ! database_exists "$dev_database"; then
    echo "Error: local database '$dev_database' does not exist." >&2
    exit 1
fi

if database_exists "$backup_database"; then
    echo "Error: backup database '$backup_database' already exists." >&2
    exit 1
fi

psql "$production_database_url" \
    --tuples-only \
    --no-align \
    --command "SELECT 1" >/dev/null

renamed_database=false

restore_original_database() {
    status=$?
    trap - ERR
    set +e

    if [[ "$renamed_database" == true ]]; then
        echo "Import failed; restoring '$backup_database' as '$dev_database'." >&2
        psql "${local_connection[@]}" \
            --dbname postgres \
            --set dev_database="$dev_database" \
            --set backup_database="$backup_database" <<'SQL'
SELECT pg_terminate_backend(pid)
FROM pg_stat_activity
WHERE datname = :'dev_database'
  AND pid <> pg_backend_pid();

SELECT format('DROP DATABASE %I', :'dev_database') \gexec
SELECT format(
    'ALTER DATABASE %I RENAME TO %I',
    :'backup_database',
    :'dev_database'
) \gexec
SQL
    fi

    exit "$status"
}

trap restore_original_database ERR

echo "Renaming '$dev_database' to '$backup_database'..."
psql "${local_connection[@]}" \
    --dbname postgres \
    --set dev_database="$dev_database" \
    --set backup_database="$backup_database" <<'SQL'
SELECT pg_terminate_backend(pid)
FROM pg_stat_activity
WHERE datname = :'dev_database'
  AND pid <> pg_backend_pid();

SELECT format(
    'ALTER DATABASE %I RENAME TO %I',
    :'dev_database',
    :'backup_database'
) \gexec
SQL
renamed_database=true

psql "${local_connection[@]}" \
    --dbname postgres \
    --set dev_database="$dev_database" <<'SQL'
SELECT format('CREATE DATABASE %I', :'dev_database') \gexec
SQL

echo "Importing production into '$dev_database'..."
pg_dump \
    --format custom \
    --no-owner \
    --no-privileges \
    "$production_database_url" |
    pg_restore \
        "${local_connection[@]}" \
        --dbname "$dev_database" \
        --exit-on-error \
        --no-owner \
        --no-privileges

renamed_database=false
trap - ERR

echo "Production data imported into '$dev_database'."
echo "Previous development database preserved as '$backup_database'."
